# Copy this file to .env and fill in your keys.
# .env is gitignored and will NOT be committed.

# --- LLM provider: "vertex" (Gemini primary + Groq fallback) or "groq" ---
LLM_PROVIDER=vertex

# --- Gemini via Vertex AI (primary) ---
# Auth uses Application Default Credentials:
#   gcloud auth application-default login
# Leave GCP_PROJECT blank to use your gcloud default project.
GCP_PROJECT=
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (fallback; also primary if LLM_PROVIDER=groq) ---
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown):
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RETRIEVAL_K=8
# MAX_CONTEXT_DOCS=48
